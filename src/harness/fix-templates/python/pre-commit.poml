<poml>
  <let name="template_id">pre-commit</let>
  <let name="output">.pre-commit-config.yaml</let>
  <let name="description">Configuración de pre-commit con ruff, black y mypy</let>
  <let name="triggers">["no linter", "no pre-commit"]</let>
  <let name="check_ids">["3.5"]</let>
  <let name="weight_recovery">1.0</let>

  <output># See https://pre-commit.com for more information
# See https://pre-commit.com/hooks.html for more hooks
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v4.6.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-added-large-files
      - id: check-json

  - repo: https://github.com/psf/black
    rev: 24.4.2
    hooks:
      - id: black
        language_version: python3

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.5.0
    hooks:
      - id: ruff
        args: [--fix]

  - repo: https://github.com/pre-commit/mirrors-mypy
    rev: v1.10.0
    hooks:
      - id: mypy
        additional_dependencies: [types-all]
        args: [--ignore-missing-imports]
  </output>
</poml>
