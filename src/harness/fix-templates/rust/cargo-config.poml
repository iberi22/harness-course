<poml>
  <let name="template_id">cargo-config</let>
  <let name="output">.cargo/config.toml</let>
  <let name="description">Configuración de Cargo con compilación incremental</let>
  <let name="triggers">["missing cargo config", "no cargo config"]</let>
  <let name="check_ids">["5.4"]</let>
  <let name="weight_recovery">1.0</let>

  <output>[build]
# Compilación incremental para builds más rápidos
incremental = true

# Número de jobs paralelos (0 = automático)
jobs = 0

[target.x86_64-unknown-linux-gnu]
linker = "clang"

[profile.dev]
# Optimizaciones mínimas en dev para compilar rápido
opt-level = 0
debug = true

[profile.release]
# Optimizaciones agresivas en release
opt-level = 3
lto = true
strip = true
  </output>
</poml>
