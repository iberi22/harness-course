{
  "env": {
    "browser": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "prefer-const": "warn",
    "eqeqeq": "warn",
    "no-var": "warn"
  },
  "ignorePatterns": ["node_modules/", ".git/", "target/"]
}
